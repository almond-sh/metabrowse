//| mill-version: 1.1.10
//| mill-jvm-opts: ["-Xss4m"]
//| mvnDeps:
//| - com.lihaoyi::mill-contrib-scalapblib:$MILL_VERSION
package build

import mill.*
import mill.api.BuildCtx
import mill.contrib.scalapblib.ScalaPBModule
import mill.javalib.publish.*
import mill.scalajslib.ScalaJSModule
import mill.scalajslib.api.{JsEnvConfig, ModuleKind}
import mill.scalalib.*
import mill.util.{Jvm, VcsVersion}

object Versions {
  val scala213Versions = Seq(
    "2.13.11",
    "2.13.12",
    "2.13.13",
    "2.13.14",
    "2.13.15",
    "2.13.16"
  )
  val scala212Versions = Seq(
    "2.12.16",
    "2.12.17",
    "2.12.18",
    "2.12.19",
    "2.12.20"
  )
  def scala213 = scala213Versions.last
  def scala212 = scala212Versions.last

  // Modules cross-published with the full Scala version (metabrowse-server_2.13.16, …)
  def fullCross = scala213Versions ++ scala212Versions
  // Modules cross-published with the binary Scala version (metabrowse-core_2.13, …)
  def binaryCross = Seq(scala213, scala212)

  def scalaJS = "1.16.0"
  def scalaPB = "0.11.17"

  def mtags = "1.3.5"
  // Important: this should be the exact same version as the one mtags pulls, as mtags uses some scalameta internal APIs,
  // and binary compatibility of these APIs isn't guaranteed.
  // Get this version with a command like 'cs resolve org.scalameta:mtags_2.13.14:1.3.1 | grep org.scalameta:scalameta'
  def scalameta = "4.9.6"

  def scalatest = "3.2.20"
  def scalacheck = "1.19.0"
  def slf4j = "2.0.18"
}

trait MetabrowseModule extends CrossSbtModule with CrossScalaVersionRanges {
  def scalacOptions = super.scalacOptions() ++ Seq(
    "-deprecation",
    "-encoding",
    "UTF-8",
    "-feature",
    "-unchecked"
  )
}

trait MetabrowseJvmModule extends MetabrowseModule {
  // Keeps Java 8 compatibility, and lets older Scala versions (2.12.16, …)
  // compile on recent JDKs
  def scalacOptions = super.scalacOptions() ++ Seq("-release", "8")
}

trait MetabrowsePublishModule extends SonatypeCentralPublishModule {
  // Same scheme as sbt-ci-release: the tag on tagged commits, a snapshot otherwise
  def publishVersion = Task {
    VcsVersion
      .vcsState()
      .format(countSep = "+", revHashDigits = 8, untaggedSuffix = "-SNAPSHOT")
  }
  def pomSettings = Task {
    PomSettings(
      description = artifactName(),
      organization = "org.scalameta",
      url = "https://github.com/scalameta/metabrowse",
      licenses = Seq(License.`Apache-2.0`),
      versionControl = VersionControl.github("scalameta", "metabrowse"),
      developers = Seq(
        Developer(
          "olafurpg",
          "Ólafur Páll Geirsson",
          "https://geirsson.com",
          email = "olafurpg@users.noreply.github.com"
        ),
        Developer(
          "jonas",
          "Jonas Fonseca",
          "https://github.com/jonas",
          email = "jonas@users.noreply.github.com"
        )
      )
    )
  }
}

/** Sources Metabrowse is tested against (the paiges git submodule), compiled
  * with SemanticDB
  */
object example extends Cross[ExampleModule](Versions.fullCross)
trait ExampleModule extends MetabrowseJvmModule { outer =>
  def moduleDir = BuildCtx.workspaceRoot / "paiges/core"
  def scalacPluginMvnDeps = Seq(
    mvn"org.scalameta:::semanticdb-scalac:${Versions.scalameta}"
  )
  def scalacOptions = super.scalacOptions() ++ Seq(
    "-Yrangepos",
    "-Xplugin-require:semanticdb",
    // defaults to the current directory, which isn't the workspace root in the Mill daemon
    s"-P:semanticdb:sourceroot:${BuildCtx.workspaceRoot}"
  )

  /** Metabrowse static site for these sources, generated by the CLI */
  def metabrowseSite = Task {
    cli(crossScalaVersion)
      .runner()
      .run(
        args = Seq[os.Shellable](
          "--clean-target-first",
          "--non-interactive",
          "--target",
          Task.dest,
          compile().classes.path,
          test.compile().classes.path
        ),
        mainClass = cli(crossScalaVersion).finalMainClass(),
        // the CLI uses the working directory as source root
        workingDir = BuildCtx.workspaceRoot
      )
    PathRef(Task.dest)
  }

  // Not a test module, as there's no need to run the paiges tests, only to compile them
  object test extends SbtModule {
    def moduleDir = outer.moduleDir
    def sourcesFolders = Seq(os.sub / "src/test/scala")
    def scalaVersion = outer.scalaVersion()
    def scalacPluginMvnDeps = outer.scalacPluginMvnDeps()
    def scalacOptions = outer.scalacOptions()
    def moduleDeps = Seq(outer)
    def mvnDeps = Seq(
      mvn"org.scalatest::scalatest:${Versions.scalatest}",
      mvn"org.scalacheck::scalacheck:${Versions.scalacheck}",
      mvn"org.scalatestplus::scalacheck-1-17:3.2.18.0"
    )
  }
}

object core extends Module {
  trait CoreModule extends MetabrowseModule with ScalaPBModule {
    def moduleDir = BuildCtx.workspaceRoot / "metabrowse-core"
    def scalaPBVersion = Versions.scalaPB
    // Don't append filename to package
    def scalaPBFlatPackage = true
    def scalaPBGrpc = false
    def scalaPBSources = Task.Sources(moduleDir / "src/main/protobuf")
    def mvnDeps = super.mvnDeps() ++ Seq(
      mvn"org.scalameta::scalameta::${Versions.scalameta}"
    )
  }

  object jvm extends Cross[CoreJvmModule](Versions.binaryCross)
  trait CoreJvmModule
      extends CoreModule
      with MetabrowseJvmModule
      with MetabrowsePublishModule {
    def artifactName = "metabrowse-core"
  }

  object js extends Cross[CoreJsModule](Versions.binaryCross)
  trait CoreJsModule extends CoreModule with ScalaJSModule {
    def scalaJSVersion = Versions.scalaJS
    def moduleKind = ModuleKind.CommonJSModule
  }
}

object server extends Cross[ServerModule](Versions.fullCross)
trait ServerModule extends MetabrowseJvmModule with MetabrowsePublishModule {
  def moduleDir = BuildCtx.workspaceRoot / "metabrowse-server"
  def artifactName = "metabrowse-server"
  def crossFullScalaVersion = true
  def moduleDeps = Seq(core.jvm())
  def mvnDeps = Seq(
    mvn"io.undertow:undertow-core:2.0.30.Final",
    mvn"org.slf4j:slf4j-api:${Versions.slf4j}",
    mvn"org.jboss.xnio:xnio-nio:3.8.0.Final",
    mvn"org.scalameta:::semanticdb-scalac-core:${Versions.scalameta}",
    mvn"org.scalameta:::mtags:${Versions.mtags}",
    mvn"com.lihaoyi::os-lib:0.11.8"
  )

  // The published JAR embeds the web UI, served by MetabrowseServer from the
  // metabrowse/server/assets resource directory
  def jar = Task {
    val jar = Task.dest / "out.jar"
    val inputs = localClasspath() :+ jsBundle.serverAssets()
    Jvm.createJar(jar, inputs.map(_.path).filter(os.exists), manifest())
    PathRef(jar)
  }
}

object cli extends Cross[CliModule](Versions.fullCross)
trait CliModule extends MetabrowseJvmModule with MetabrowsePublishModule {
  def moduleDir = BuildCtx.workspaceRoot / "metabrowse-cli"
  def artifactName = "metabrowse-cli"
  def crossFullScalaVersion = true
  def mainClass = Some("metabrowse.cli.MetabrowseCli")
  def moduleDeps = Seq(server())
  def mvnDeps = Seq(
    mvn"com.thesamet.scalapb::scalapb-json4s:0.12.2",
    mvn"com.github.alexarchambault::case-app:2.0.6",
    mvn"com.github.pathikrit::better-files:3.9.2"
  ) ++ {
    if (crossScalaVersion.startsWith("2.12.")) Nil
    else Seq(mvn"org.scala-lang.modules::scala-parallel-collections:1.2.0")
  }
}

object js extends Cross[JsModule](Versions.binaryCross)
trait JsModule extends MetabrowseModule with ScalaJSModule {
  def moduleDir = BuildCtx.workspaceRoot / "metabrowse-js"
  def scalaJSVersion = Versions.scalaJS
  def moduleKind = ModuleKind.CommonJSModule
  def mainClass = Some("metabrowse.MetabrowseApp")
  def moduleDeps = Seq(core.js())
  def mvnDeps = Seq(
    mvn"org.scala-js::scalajs-dom::0.9.8"
  )

  object test
      extends CrossSbtTests
      with ScalaJSTests
      with TestModule.ScalaTest {
    def mvnDeps = Seq(
      mvn"org.scalatest::scalatest::${Versions.scalatest}"
    )
    def jsEnvConfig = Task {
      // Some tests require NPM modules, such as pako
      val nodePath = jsBundle.nodeModules().path / "node_modules"
      val siteDir = example().metabrowseSite().path
      JsEnvConfig.NodeJs(env =
        Map(
          "NODE_PATH" -> nodePath.toString,
          "METABROWSE_SITE_DIR" -> siteDir.toString
        )
      )
    }
  }
}

/** Bundles the Scala.js application with webpack, along with the Monaco editor
  * and the other NPM dependencies listed in metabrowse-js/package.json
  */
object jsBundle extends Module {
  def moduleDir = BuildCtx.workspaceRoot / "metabrowse-js"

  def npmFiles = Task.Sources(
    moduleDir / "package.json",
    moduleDir / "yarn.lock",
    BuildCtx.workspaceRoot / ".yarnrc"
  )
  def webpackConfig = Task.Source(moduleDir / "webpack.config.js")
  def webResources = Task.Source(moduleDir / "src/main/resources")

  /** A directory with a node_modules subdirectory, populated by yarn */
  def nodeModules = Task {
    for (f <- npmFiles())
      os.copy.into(f.path, Task.dest)
    os.proc("yarn", "install", "--frozen-lockfile", "--non-interactive")
      .call(cwd = Task.dest, stdout = os.Inherit)
    PathRef(Task.dest)
  }

  // webpack 4 relies on legacy OpenSSL hashes, unavailable by default since Node 17
  private def nodeOptions(): Map[String, String] = {
    val nodeVersion = os.proc("node", "--version").call().out.trim()
    val nodeMajor = nodeVersion.stripPrefix("v").takeWhile(_.isDigit).toInt
    if (nodeMajor >= 17) {
      val options =
        sys.env.get("NODE_OPTIONS").toSeq :+ "--openssl-legacy-provider"
      Map("NODE_OPTIONS" -> options.distinct.mkString(" "))
    } else
      Map.empty
  }

  /** Sets up a directory from which webpack can be run, with the configuration
    * scalajs-bundler used to generate
    */
  private def setupWebpackDir(
      dir: os.Path,
      nodeModules: os.Path,
      webpackConfig: os.Path,
      entry: os.Path,
      output: os.Path
  ): Unit = {
    os.makeDir.all(dir)
    os.symlink(dir / "node_modules", nodeModules / "node_modules")
    os.copy.into(webpackConfig, dir)
    os.write(
      dir / "scalajs.webpack.config.js",
      s"""module.exports = {
        |  "entry": {
        |    "metabrowse-js-fastopt": [${ujson.Str(entry.toString).render()}]
        |  },
        |  "output": {
        |    "path": ${ujson.Str(output.toString).render()},
        |    "filename": "[name]-bundle.js"
        |  },
        |  "resolve": {
        |    // the Scala.js output lives outside of this directory
        |    "modules": [${ujson
          .Str((dir / "node_modules").toString)
          .render()}, "node_modules"]
        |  },
        |  "devtool": "source-map",
        |  "module": {
        |    "rules": [{
        |      "test": new RegExp("\\\\.js$$"),
        |      "enforce": "pre",
        |      "use": ["source-map-loader"]
        |    }]
        |  }
        |}
        |""".stripMargin
    )
  }

  private def linkedJs = Task.Anon {
    // FIXME - use fullLinkJS: https://github.com/scalameta/metabrowse/issues/271
    val report = js(Versions.scala213).fastLinkJS()
    report.dest.path / report.publicModules.head.jsFileName
  }

  /** The web UI, under the metabrowse/server/assets resource directory */
  def serverAssets = Task {
    val workDir = Task.dest / "webpack"
    val output = Task.dest / "assets/metabrowse/server/assets"
    setupWebpackDir(
      workDir,
      nodeModules().path,
      webpackConfig().path,
      linkedJs(),
      output
    )
    os.proc(
      "node",
      workDir / "node_modules/webpack/bin/webpack.js",
      "--config",
      workDir / "webpack.config.js",
      "-p",
      "--mode",
      "production"
    ).call(
      cwd = workDir,
      env = nodeOptions() ++ Map(
        "METABROWSE_RESOURCES_DIR" -> webResources().path.toString
      ),
      stdout = os.Inherit
    )
    PathRef(Task.dest / "assets")
  }

  /** Spins up a local file server serving the site generated for the example
    * sources, that listens for changes. Run `./mill -w js[2.13.16].fastLinkJS`
    * in parallel so that the browser refreshes on edit.
    */
  def devServer() = Task.Command(exclusive = true) {
    val workDir = Task.dest / "webpack"
    val siteDir = example(Versions.scala213).metabrowseSite().path
    setupWebpackDir(
      workDir,
      nodeModules().path,
      webpackConfig().path,
      linkedJs(),
      workDir
    )
    os.proc(
      "node",
      workDir / "node_modules/webpack-dev-server/bin/webpack-dev-server.js",
      "--config",
      workDir / "webpack.config.js"
    ).call(
      cwd = workDir,
      env = nodeOptions() ++ Map(
        "METABROWSE_RESOURCES_DIR" -> webResources().path.toString,
        "METABROWSE_SITE_DIR" -> siteDir.toString
      ),
      stdin = os.Inherit,
      stdout = os.Inherit
    )
    ()
  }
}

object tests extends Cross[TestsModule](Versions.fullCross)
trait TestsModule extends MetabrowseJvmModule {
  def moduleDir = BuildCtx.workspaceRoot / "metabrowse-tests"
  def moduleDeps = Seq(cli(), server())
  def mvnDeps = Seq(
    mvn"org.scalameta::testkit:${Versions.scalameta}",
    mvn"org.scalameta:::semanticdb-scalac-core:${Versions.scalameta}",
    mvn"org.scalatest::scalatest:${Versions.scalatest}",
    mvn"org.scalacheck::scalacheck:${Versions.scalacheck}",
    mvn"org.slf4j:slf4j-simple:${Versions.slf4j}"
  )

  def buildInfo = Task {
    val exampleClassDirectories = Seq(
      example().compile().classes.path,
      example().test.compile().classes.path
    )
    def file(path: os.Path) =
      s"new java.io.File(${ujson.Str(path.toString).render()})"
    os.write(
      Task.dest / "BuildInfo.scala",
      s"""package metabrowse.tests
        |
        |object BuildInfo {
        |  val sourceroot: java.io.File = ${file(BuildCtx.workspaceRoot)}
        |  val exampleClassDirectory: List[java.io.File] = List(
        |    ${exampleClassDirectories.map(file).mkString(",\n    ")}
        |  )
        |}
        |""".stripMargin
    )
    PathRef(Task.dest)
  }
  def generatedSources = Task { super.generatedSources() :+ buildInfo() }

  // Allows to run the tests on another JVM, like "temurin:11". Test modules use
  // the JVM of their parent module. Mill compiles with that JVM too, so it
  // needs to be Java 11 or later.
  def jvmVersion = Task.Input {
    Task.env.getOrElse("METABROWSE_TEST_JVM", "")
  }

  object test extends CrossSbtTests with TestModule.ScalaTest

  object it extends CrossSbtTests with TestModule.ScalaTest {
    def mvnDeps = Seq(
      mvn"org.seleniumhq.selenium:selenium-java:4.44.0",
      mvn"org.scalatestplus::selenium-4-41:3.2.20.0"
    )
    // Make the web UI available to the server started by the tests
    def runClasspath = super.runClasspath() :+ jsBundle.serverAssets()
  }
}
